{
	"info": {
		"_postman_id": "879ce6fd-6aca-4040-958f-241ef559c595",
		"name": "Message Broker Go",
		"description": "Postman collection for Go-based Message Broker supporting REST, gRPC, and Active Delivery.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Messages",
			"item": [
				{
					"name": "Push Message (Simple)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"id\": \"TX-{{$randomInt}}\",\n    \"payload\": \"Hello from Postman\",\n    \"target\": \"sample_service\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/messages",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"messages"
							]
						},
						"description": "Push a simple string message to the broker."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Response has status pushed\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.eql(\"pushed\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"response": []
				},
				{
					"name": "Push Message (Structured JSON)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"id\": \"JSON-{{$randomInt}}\",\n    \"payload\": {\n        \"event\": \"user_signup\",\n        \"data\": {\n            \"user_id\": 42,\n            \"role\": \"admin\",\n            \"timestamp\": \"{{$isoTimestamp}}\"\n        }\n    },\n    \"target\": \"email_service\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/messages",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"messages"
							]
						},
						"description": "Push a complex JSON object as payload."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"response": []
				},
				{
					"name": "Pop Message",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/messages",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"messages"
							]
						},
						"description": "Retrieve and remove the oldest message from the queue."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has message properties\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property(\"id\");",
									"    pm.expect(jsonData).to.have.property(\"payload\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"response": []
				},
				{
					"name": "Push Message with Headers",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"id\": \"HDR-{{$randomInt}}\",\n    \"target\": \"auth-service\",\n    \"payload\": {\n        \"action\": \"process_data\",\n        \"value\": 123\n    },\n    \"headers\": {\n        \"X-Custom-Auth\": \"SecretToken-999\",\n        \"X-Trace-ID\": \"{{$guid}}\"\n    }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/messages",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"messages"
							]
						},
						"description": "Push a message with custom headers. These headers will be sent to the target system (HTTP Headers or gRPC Metadata)."
					},
					"response": []
				},
				{
					"name": "Get All Messages",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/messages/all",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"messages",
								"all"
							]
						},
						"description": "List all messages currently in the queue without removing them."
					},
					"response": []
				}
			]
		},
