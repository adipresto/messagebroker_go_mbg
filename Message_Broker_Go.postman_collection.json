		{
			"name": "Active Delivery",
			"item": [
				{
					"name": "Register Webhook Target",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"local_service\",\n    \"url\": \"http://localhost:9090/webhook\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/targets",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"targets"
							]
						},
						"description": "Register an external HTTP target for automatic message delivery."
					},
					"response": []
				},
				{
					"name": "Register Webhook Target with Headers",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"auth-target\",\n    \"url\": \"{{webhook_mock_url}}\",\n    \"headers\": {\n        \"Authorization\": \"Bearer InitialToken000\",\n        \"X-Service-Source\": \"Broker-Core\"\n    }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/targets",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"targets"
							]
						},
						"description": "Register an external HTTP target with default headers. These headers will be automatically added to all messages delivered to this target (unless overridden by the message)."
					},
					"response": []
				}
			]
		},
